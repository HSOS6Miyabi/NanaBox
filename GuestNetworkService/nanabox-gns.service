[Unit]
Description=NanaBox guest network configuration service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nanabox-gns/gns.py serve
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=nanabox-gns
StateDirectoryMode=0700
RuntimeDirectory=nanabox-gns
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStopPost=/usr/bin/python3 -I /opt/nanabox-gns/gns.py clear-loopback /run/nanabox-gns/loopback.json
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_VSOCK

[Install]
WantedBy=multi-user.target
