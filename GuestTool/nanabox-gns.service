[Unit]
Description=NanaBox guest network configuration service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/nanabox-gns/nanabox-guest-tool --serve --network
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=nanabox-gns
StateDirectoryMode=0700
RuntimeDirectory=nanabox-gns
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_VSOCK

[Install]
WantedBy=multi-user.target
