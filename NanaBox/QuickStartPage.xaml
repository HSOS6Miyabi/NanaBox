<Page
  x:Class="NanaBox.QuickStartPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Padding="24,18,24,14" Spacing="4">
      <TextBlock x:Name="WelcomeHeading" Text="Your virtual machines" TextWrapping="Wrap" FontSize="27" FontWeight="SemiBold" AutomationProperties.AutomationId="WorkspaceHeading" />
      <TextBlock x:Name="WelcomeSubtitle" Text="Create, open and manage your virtual machine workspaces." TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="WorkspaceSidebarColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border BorderThickness="0,0,1,0" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,8,16,16" Spacing="7">
            <TextBlock x:Name="ActionsLabel" Text="Get started" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
            <Button x:Name="QuickStartCreateVirtualMachineButton" Click="CreateVirtualMachineButtonClick" AutomationProperties.AutomationId="QuickStartCreateVirtualMachineButton" AutomationProperties.Name="Create virtual machine" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Add" /><TextBlock x:Name="QuickStartCreateVirtualMachineButtonText" Grid.Column="1" Text="Create virtual machine" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartLaunchVirtualMachineButton" Click="LaunchVirtualMachineButtonClick" AutomationProperties.AutomationId="QuickStartLaunchVirtualMachineButton" AutomationProperties.Name="Open and start" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Play" /><TextBlock x:Name="QuickStartLaunchVirtualMachineButtonText" Grid.Column="1" Text="Open and start" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartAddWorkspaceButton" Click="AddWorkspaceButtonClick" AutomationProperties.AutomationId="QuickStartAddWorkspaceButton" AutomationProperties.Name="Add to workspace" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Add" /><TextBlock x:Name="QuickStartAddWorkspaceButtonText" Grid.Column="1" Text="Add to workspace" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartVirtualMachineSettingsButton" Click="VirtualMachineSettingsButtonClick" AutomationProperties.AutomationId="QuickStartVirtualMachineSettingsButton" AutomationProperties.Name="Open settings file" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Setting" /><TextBlock x:Name="QuickStartVirtualMachineSettingsButtonText" Grid.Column="1" Text="Open settings file" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              
              <TextBlock x:Name="ToolsLabel" Text="Virtual disk tools" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,2" />
<Button x:Name="QuickStartCreateVirtualHardDiskButton" Click="CreateVirtualHardDiskButtonClick" AutomationProperties.AutomationId="QuickStartCreateVirtualHardDiskButton" AutomationProperties.Name="Create virtual disk" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Add" /><TextBlock x:Name="QuickStartCreateVirtualHardDiskButtonText" Grid.Column="1" Text="Create virtual disk" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartResizeVirtualHardDiskButton" Click="ResizeVirtualHardDiskButtonClick" AutomationProperties.AutomationId="QuickStartResizeVirtualHardDiskButton" AutomationProperties.Name="Resize virtual disk" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Zoom" /><TextBlock x:Name="QuickStartResizeVirtualHardDiskButtonText" Grid.Column="1" Text="Resize virtual disk" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartCompactVirtualHardDiskButton" Click="CompactVirtualHardDiskButtonClick" AutomationProperties.AutomationId="QuickStartCompactVirtualHardDiskButton" AutomationProperties.Name="Compact virtual disk" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="BackToWindow" /><TextBlock x:Name="QuickStartCompactVirtualHardDiskButtonText" Grid.Column="1" Text="Compact virtual disk" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="QuickStartAboutButton" Click="AboutButtonClick" AutomationProperties.AutomationId="QuickStartAboutButton" AutomationProperties.Name="About NanaBox" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" >
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Help" /><TextBlock x:Name="QuickStartAboutButtonText" Grid.Column="1" Text="About NanaBox" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1" Padding="20,8,20,12" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="RecentLabel" Text="Recent workspaces" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="WorkspaceRefreshButton" Click="RefreshWorkspaceButtonClick" AutomationProperties.AutomationId="WorkspaceRefreshButton">
            <SymbolIcon Symbol="Refresh" />
          </Button>
        </Grid>
        <TextBox Grid.Row="1" x:Name="WorkspaceSearchBox" PlaceholderText="Search by name or path" AutomationProperties.AutomationId="WorkspaceSearchBox" TextChanged="WorkspaceSearchChanged" />
        <Grid Grid.Row="2" MinHeight="70">
          <ListView x:Name="WorkspaceList" SelectionMode="Single" SelectionChanged="WorkspaceSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="WorkspaceList">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,8" /><Setter Property="MinHeight" Value="76" /></Style></ListView.ItemContainerStyle>
          </ListView>
          <TextBlock x:Name="WorkspaceEmptyText" Text="Loading recent workspaces…" TextWrapping="Wrap" Margin="12,18" Opacity="0.8" IsHitTestVisible="False" AutomationProperties.AutomationId="WorkspaceEmptyText" />
        </Grid>
        <Grid Grid.Row="3" RowSpacing="7" ColumnSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button x:Name="WorkspaceStartButton" Click="StartWorkspaceButtonClick" AutomationProperties.AutomationId="WorkspaceStartButton" AutomationProperties.Name="Start" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" Grid.Column="0" Grid.Row="0">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Play" /><TextBlock x:Name="WorkspaceStartButtonText" Grid.Column="1" Text="Start" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="WorkspaceSettingsButton" Click="WorkspaceSettingsButtonClick" AutomationProperties.AutomationId="WorkspaceSettingsButton" AutomationProperties.Name="Settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" Grid.Column="1" Grid.Row="0">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Setting" /><TextBlock x:Name="WorkspaceSettingsButtonText" Grid.Column="1" Text="Settings" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="WorkspaceFolderButton" Click="WorkspaceFolderButtonClick" AutomationProperties.AutomationId="WorkspaceFolderButton" AutomationProperties.Name="Open folder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" Grid.Column="0" Grid.Row="1">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Folder" /><TextBlock x:Name="WorkspaceFolderButtonText" Grid.Column="1" Text="Open folder" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
              <Button x:Name="WorkspaceRemoveButton" Click="RemoveWorkspaceButtonClick" AutomationProperties.AutomationId="WorkspaceRemoveButton" AutomationProperties.Name="Remove from list" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="38" Grid.Column="1" Grid.Row="1">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><SymbolIcon Symbol="Remove" /><TextBlock x:Name="WorkspaceRemoveButtonText" Grid.Column="1" Text="Remove from list" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              </Button>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Padding="16,8,16,10" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="WorkspaceStatusText" Text="Loading recent workspaces…" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkspaceStatusText" />
      <Button Grid.Column="1" x:Name="WorkspaceClearButton" Content="Clear history" Click="ClearWorkspacesButtonClick" AutomationProperties.AutomationId="WorkspaceClearButton" />
    </Grid>
  </Grid>
</Page>
