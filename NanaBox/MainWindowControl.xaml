<Page
  x:Class="NanaBox.MainWindowControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaBox"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  Loaded="PageLoaded"
  mc:Ignorable="d">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="0" />
      <ColumnDefinition Width="auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <CommandBar
      Grid.Column="0"
      HorizontalAlignment="Stretch"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Center"
      Background="Transparent"
      DefaultLabelPosition="Collapsed"
      IsDynamicOverflowEnabled="True"
      IsOpen="False">
      <AppBarToggleButton
        x:Name="EnhancedSessionButton"
        x:Uid="/MainWindow/EnhancedSessionButton"
        Width="48"
        AutomationProperties.Name="[Enhanced Session]"
        Checked="EnhancedSessionButtonChanged" Unchecked="EnhancedSessionButtonChanged"
        Icon="NewWindow"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Enhanced Session]" AutomationProperties.AutomationId="EnhancedSessionButton" />
      <AppBarButton
        x:Uid="/MainWindow/FullScreenButton"
        Width="48"
        AutomationProperties.Name="[Full Screen]"
        Click="FullScreenButtonClick"
        Icon="FullScreen"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Full Screen]" AutomationProperties.AutomationId="FullScreenButton" />
      <AppBarSeparator />
      <AppBarToggleButton
        x:Name="PauseVirtualMachineButton"
        x:Uid="/MainWindow/PauseVirtualMachineButton"
        Width="48"
        AutomationProperties.Name="[Pause Virtual Machine]"
        Checked="PauseVirtualMachineButtonChanged" Unchecked="PauseVirtualMachineButtonChanged"
        Icon="Pause"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Pause Virtual Machine]" AutomationProperties.AutomationId="PauseVirtualMachineButton" />
      <AppBarButton
        x:Name="RestartVirtualMachineButton"
        x:Uid="/MainWindow/RestartVirtualMachineButton"
        Width="48"
        AutomationProperties.Name="[Restart Virtual Machine]"
        Click="RestartVirtualMachineButtonClick"
        Icon="Refresh"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Restart Virtual Machine]" AutomationProperties.AutomationId="RestartVirtualMachineButton" />
      <AppBarButton x:Name="PowerMenuButton" Icon="Stop" Width="48" LabelPosition="Collapsed"
        x:Uid="/MainWindow/PowerMenu" AutomationProperties.Name="Power options" ToolTipService.ToolTip="Power options" AutomationProperties.AutomationId="PowerMenu">
        <AppBarButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem x:Name="ShutdownAction" x:Uid="/MainWindow/ShutdownAction" Text="Shut down guest" Tag="Shutdown" Click="PowerActionClick" AutomationProperties.AutomationId="ShutdownAction" />
            <MenuFlyoutItem x:Name="SaveAction" x:Uid="/MainWindow/SaveAction" Text="Save state and close" Tag="Save" Click="PowerActionClick" AutomationProperties.AutomationId="SaveAction" />
            <MenuFlyoutItem x:Uid="/MainWindow/PowerOffAction" Text="Force power off" Tag="PowerOff" Click="PowerActionClick" AutomationProperties.AutomationId="PowerOffAction" />
          </MenuFlyout>
        </AppBarButton.Flyout>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarButton
        x:Uid="/MainWindow/VirtualMachineSettingsButton"
        Width="48"
        AutomationProperties.Name="[Virtual Machine Settings]"
        Click="VirtualMachineSettingsButtonClick"
        Icon="Setting"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Virtual Machine Settings]" AutomationProperties.AutomationId="VirtualMachineSettingsButton" />
      <AppBarToggleButton
        x:Name="RedirectKeyboardNavigationButton"
        x:Uid="/MainWindow/RedirectKeyboardNavigationButton"
        Width="48"
        AutomationProperties.Name="[Redirect Keyboard Navigation]"
        Checked="RedirectKeyboardNavigationButtonChanged" Unchecked="RedirectKeyboardNavigationButtonChanged"
        Icon="Keyboard"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Redirect Keyboard Navigation]" AutomationProperties.AutomationId="RedirectKeyboardNavigationButton" />
      <AppBarButton
        x:Uid="/MainWindow/RestoreVirtualMachineWindowSizeButton"
        Width="48"
        AutomationProperties.Name="[Restore Virtual Machine Window Size]"
        Click="RestoreVirtualMachineWindowSizeButtonClick"
        Icon="BackToWindow"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Restore Virtual Machine Window Size]" AutomationProperties.AutomationId="RestoreVirtualMachineWindowSizeButton" />
      <AppBarButton
        x:Name="TypeClipboardTextButton"
        x:Uid="/MainWindow/TypeClipboardTextButton"
        Icon="Paste" Width="48" LabelPosition="Collapsed"
        Click="TypeClipboardTextButtonClick"
        AutomationProperties.Name="Type clipboard text"
        ToolTipService.ToolTip="Type clipboard text with the configured keyboard layout"
        AutomationProperties.AutomationId="TypeClipboardTextButton" />
      <AppBarButton
        x:Uid="/MainWindow/CopyScreenshotButton"
        Width="48"
        AutomationProperties.Name="[Copy Screenshot]"
        Click="CopyScreenshotButtonClick"
        Icon="Camera"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Copy Screenshot]" AutomationProperties.AutomationId="CopyScreenshotButton" />
      <AppBarToggleButton
        x:Name="RecordVideoButton"
        x:Uid="/MainWindow/RecordVideoButton"
        Width="48"
        AutomationProperties.Name="[Record Video]"
        Checked="RecordVideoButtonChanged" Unchecked="RecordVideoButtonChanged"
        Icon="Video"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Record Video]" AutomationProperties.AutomationId="RecordVideoButton" />
      <AppBarSeparator />
      <AppBarButton
        x:Uid="/MainWindow/CreateVirtualHardDiskButton"
        Width="48"
        AutomationProperties.Name="[Create Virtual Hard Disk]"
        Click="CreateVirtualHardDiskButtonClick"
        Icon="Add"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Create Virtual Hard Disk]" AutomationProperties.AutomationId="CreateVirtualHardDiskButton" />
      <AppBarButton
        x:Uid="/MainWindow/ResizeVirtualHardDiskButton"
        Width="48"
        AutomationProperties.Name="[Resize Virtual Hard Disk]"
        Click="ResizeVirtualHardDiskButtonClick"
        Icon="Zoom"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Resize Virtual Hard Disk]" AutomationProperties.AutomationId="ResizeVirtualHardDiskButton" />
      <AppBarButton
        x:Uid="/MainWindow/CompactVirtualHardDiskButton"
        Width="48"
        AutomationProperties.Name="[Compact Virtual Hard Disk]"
        Click="CompactVirtualHardDiskButtonClick"
        Icon="BackToWindow"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[Compact Virtual Hard Disk]" AutomationProperties.AutomationId="CompactVirtualHardDiskButton" />
      <AppBarButton
        x:Uid="/MainWindow/AboutButton"
        Width="48"
        AutomationProperties.Name="[About NanaBox]"
        Click="AboutButtonClick"
        Icon="Help"
        LabelPosition="Collapsed"
        ToolTipService.ToolTip="[About NanaBox]" AutomationProperties.AutomationId="AboutButton" />
    </CommandBar>
    <Button
      x:Name="SponsorButton"
      Grid.Column="2"
      Margin="0,0,6,0"
      VerticalAlignment="Center"
      Background="Transparent"
      Click="SponsorButtonClick"
      Content="[Sponsor NanaBox]" AutomationProperties.AutomationId="SponsorButton" />
  </Grid>
</Page>
