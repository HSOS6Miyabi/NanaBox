<Page
  x:Class="NanaBox.VirtualMachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaBox"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="16,8">
      <Grid.Background>
        <SolidColorBrush Opacity="0.2" Color="{ThemeResource SystemChromeHighColor}" />
      </Grid.Background>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="ReloadButton"
        x:Uid="/VirtualMachineSettingsPage/ReloadButton"
        Grid.Column="0"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Reload Configuration]"
        Click="ReloadButtonClick" AutomationProperties.AutomationId="ReloadButton">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReloadButtonTextBlock"
          Text="[Reload Configuration]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="OpenButton"
        x:Uid="/VirtualMachineSettingsPage/OpenButton"
        Grid.Column="1"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Open Virtual Machine Configuration File]"
        Click="OpenButtonClick" AutomationProperties.AutomationId="OpenButton">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/OpenButtonTextBlock"
          Text="[Open Virtual Machine Configuration File]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ReferenceButton"
        x:Uid="/VirtualMachineSettingsPage/ReferenceButton"
        Grid.Column="2"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Configuration File Reference Documentation]"
        Click="ReferenceButtonClick" AutomationProperties.AutomationId="ReferenceButton">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReferenceButtonTextBlock"
          Text="[Configuration File Reference Documentation]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ApplyButton"
        x:Uid="/VirtualMachineSettingsPage/ApplyButton"
        Grid.Column="3"
        Margin="0,0,0,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Apply Changes]"
        Click="ApplyButtonClick" AutomationProperties.AutomationId="ApplyButton">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ApplyButtonTextBlock"
          Text="[Apply Changes]"
          TextWrapping="Wrap" />
      </Button>
    </Grid>
    <Pivot Grid.Row="1">
      <PivotItem x:Uid="/VirtualMachineSettingsPage/TabGeneral" Header="General" AutomationProperties.AutomationId="TabGeneral">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,4,16,16" Spacing="8">

            <TextBlock
              x:Name="RuntimeNotice"
              x:Uid="/VirtualMachineSettingsPage/RuntimeNoticeText"
              Text="[Only settings that can be changed at runtime are shown.]"
              TextWrapping="Wrap" />
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/GeneralTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="[General]" />
            <StackPanel x:Name="GuestTypeRow" Spacing="4">
              <TextBlock x:Uid="/VirtualMachineSettingsPage/GuestTypeLabel" Text="Guest operating system" />
              <ComboBox x:Name="GuestTypeComboBox" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="GuestTypeComboBox">
                <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/GuestUnknown" Content="Unknown" AutomationProperties.AutomationId="GuestUnknown" />
                <ComboBoxItem Content="Windows" />
                <ComboBoxItem Content="Linux" />
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="NameRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/NameLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[Name]"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="NameTextBox"
                  x:Uid="/VirtualMachineSettingsPage/NameTextBox"
                  Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.HelpText="[The unique name of virtual machine.]"
                  AutomationProperties.Name="[Name]"
                  ToolTipService.ToolTip="[The unique name of virtual machine.]" AutomationProperties.AutomationId="NameTextBox" />
              </Grid>
            </StackPanel>
            <StackPanel x:Name="ProcessorCountRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/ProcessorCountLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[ProcessorCount]"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="ProcessorCountTextBox"
                  x:Uid="/VirtualMachineSettingsPage/ProcessorCountTextBox"
                  Grid.Column="1"
                  Width="120"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[The processor count of virtual machine, in cores.]"
                  AutomationProperties.Name="[ProcessorCount]"
                  ToolTipService.ToolTip="[The processor count of virtual machine, in cores.]" AutomationProperties.AutomationId="ProcessorCountTextBox" />
              </Grid>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/MemorySizeLabel"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="[MemorySize (MB)]"
                TextWrapping="Wrap" />
              <TextBox
                x:Name="MemorySizeTextBox"
                x:Uid="/VirtualMachineSettingsPage/MemorySizeTextBox"
                Grid.Column="1"
                Width="120"
                HorizontalAlignment="Left"
                AutomationProperties.HelpText="[The memory size of virtual machine, in MB.]"
                AutomationProperties.Name="[MemorySize (MB)]"
                ToolTipService.ToolTip="[The memory size of virtual machine, in MB.]" AutomationProperties.AutomationId="MemorySizeTextBox" />
            </Grid>
            <StackPanel x:Name="SecureBootRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/SecureBootLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[SecureBoot]"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="SecureBootCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/SecureBootCheckBox"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[(Optional) The Secure Boot setting of virtual machine.]"
                  AutomationProperties.Name="[SecureBoot]"
                  ToolTipService.ToolTip="[(Optional) The Secure Boot setting of virtual machine.]" AutomationProperties.AutomationId="SecureBootCheckBox" />
              </Grid>
            </StackPanel>
            <StackPanel x:Name="TpmRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/TpmLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[Tpm]"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="TpmCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/TpmCheckBox"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[(Optional) The Trusted Platform Module (TPM) setting of virtual machine.]"
                  AutomationProperties.Name="[Tpm]"
                  ToolTipService.ToolTip="[(Optional) The Trusted Platform Module (TPM) setting of virtual machine.]" AutomationProperties.AutomationId="TpmCheckBox" />
              </Grid>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/TpmNote"
                FontSize="12"
                Opacity="0.75"
                Text="[Note: You need Windows 11 Version 24H2 or later Host OS.]"
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="VirtualizationExtensionsRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[ExposeVirtualizationExtensions]"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="VirtualizationExtensionsCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsCheckBox"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[(Optional) Expose the virtualization extensions to the virtual machine if set it true.]"
                  AutomationProperties.Name="[ExposeVirtualizationExtensions]"
                  ToolTipService.ToolTip="[(Optional) Expose the virtualization extensions to the virtual machine if set it true.]" AutomationProperties.AutomationId="VirtualizationExtensionsCheckBox" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem x:Uid="/VirtualMachineSettingsPage/TabSerial" Header="Serial" AutomationProperties.AutomationId="TabSerial">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,4,16,16" Spacing="8">
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/ComPortsTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="[ComPorts]" />
            <StackPanel x:Name="UefiConsoleRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/UefiConsoleLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[UefiConsole]"
                  TextWrapping="Wrap" />
                <ComboBox
                  x:Name="UefiConsoleComboBox"
                  x:Uid="/VirtualMachineSettingsPage/UefiConsoleComboBox"
                  Grid.Column="1"
                  MinWidth="120"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[The UEFI serial console setting of virtual machine.]"
                  AutomationProperties.Name="[UefiConsole]"
                  ToolTipService.ToolTip="[The UEFI serial console setting of virtual machine.]" AutomationProperties.AutomationId="UefiConsoleComboBox">
                  <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDisabledItem" Content="Disabled" AutomationProperties.AutomationId="ChoiceDisabledItem" />
                  <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDefaultItem" Content="Default" AutomationProperties.AutomationId="ChoiceDefaultItem" />
                  <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceComPort1Item" Content="ComPort1" AutomationProperties.AutomationId="ChoiceComPort1Item" />
                  <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceComPort2Item" Content="ComPort2" AutomationProperties.AutomationId="ChoiceComPort2Item" />
                </ComboBox>
              </Grid>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/ComPort1Label"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="[ComPort1]"
                TextWrapping="Wrap" />
              <TextBox
                x:Name="ComPort1TextBox"
                x:Uid="/VirtualMachineSettingsPage/ComPort1TextBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.HelpText="[(Optional) The named pipe path of guest COM1 of virtual machine.]"
                AutomationProperties.Name="[ComPort1]"
                ToolTipService.ToolTip="[(Optional) The named pipe path of guest COM1 of virtual machine.]" AutomationProperties.AutomationId="ComPort1TextBox" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/ComPort2Label"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="[ComPort2]"
                TextWrapping="Wrap" />
              <TextBox
                x:Name="ComPort2TextBox"
                x:Uid="/VirtualMachineSettingsPage/ComPort2TextBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.HelpText="[(Optional) The named pipe path of guest COM2 of virtual machine.]"
                AutomationProperties.Name="[ComPort2]"
                ToolTipService.ToolTip="[(Optional) The named pipe path of guest COM2 of virtual machine.]" AutomationProperties.AutomationId="ComPort2TextBox" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Uid="/VirtualMachineSettingsPage/GenerateCom1" Content="Generate COM1 pipe" Tag="1" Click="SerialPipeButtonClick" AutomationProperties.AutomationId="GenerateCom1" />
              <Button x:Uid="/VirtualMachineSettingsPage/ClearCom1" Content="Disconnect COM1" Tag="Clear1" Click="SerialPipeButtonClick" AutomationProperties.AutomationId="ClearCom1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Uid="/VirtualMachineSettingsPage/GenerateCom2" Content="Generate COM2 pipe" Tag="2" Click="SerialPipeButtonClick" AutomationProperties.AutomationId="GenerateCom2" />
              <Button x:Uid="/VirtualMachineSettingsPage/ClearCom2" Content="Disconnect COM2" Tag="Clear2" Click="SerialPipeButtonClick" AutomationProperties.AutomationId="ClearCom2" />
            </StackPanel>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/StateNote"
              FontSize="12"
              Opacity="0.75"
              Text="[Note: The relative path is supported.]"
              TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem x:Uid="/VirtualMachineSettingsPage/TabGpu" Header="Gpu" AutomationProperties.AutomationId="TabGpu">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,4,16,16" Spacing="8">
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/GpuTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="[Gpu]" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/AssignmentModeLabel"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="[AssignmentMode]"
                TextWrapping="Wrap" />
              <ComboBox
                x:Name="AssignmentModeComboBox"
                x:Uid="/VirtualMachineSettingsPage/AssignmentModeComboBox"
                Grid.Column="1"
                MinWidth="120"
                HorizontalAlignment="Left"
                AutomationProperties.HelpText="[The GPU assignment mode setting of virtual machine.]"
                AutomationProperties.Name="[AssignmentMode]"
                ToolTipService.ToolTip="[The GPU assignment mode setting of virtual machine.]" AutomationProperties.AutomationId="AssignmentModeComboBox">
                <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDisabledItem2" Content="Disabled" AutomationProperties.AutomationId="ChoiceDisabledItem2" />
                <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDefaultItem2" Content="Default" AutomationProperties.AutomationId="ChoiceDefaultItem2" />
                <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceListItem" Content="List" AutomationProperties.AutomationId="ChoiceListItem" />
                <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceMirrorItem" Content="Mirror" AutomationProperties.AutomationId="ChoiceMirrorItem" />
              </ComboBox>
            </Grid>
            <StackPanel x:Name="EnableHostDriverStoreRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreLabel"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Text="[EnableHostDriverStore]"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="EnableHostDriverStoreCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreCheckBox"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="[(Optional) Set it true if you want to enable readonly Plan 9 and Virtual SMB shares for several GPU-PV (paravirtualization) related folders from the Host OS.]"
                  AutomationProperties.Name="[EnableHostDriverStore]"
                  ToolTipService.ToolTip="[(Optional) Set it true if you want to enable readonly Plan 9 and Virtual SMB shares for several GPU-PV (paravirtualization) related folders from the Host OS.]" AutomationProperties.AutomationId="EnableHostDriverStoreCheckBox" />
              </Grid>
              <TextBlock
                x:Uid="/VirtualMachineSettingsPage/ShareNote"
                FontSize="12"
                Opacity="0.75"
                Text="[Note: You cannot suspend the virtual machine properly if this option is enabled.]"
                TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/GpuDeviceTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="[SelectedDevices]" />
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/GpuDeviceDescription"
              FontSize="12"
              Opacity="0.75"
              Text="[(Optional) The string or object array of selected GPUs used for virtual machine. Set as the object with &quot;DeviceInterface&quot; and &quot;PartitionId&quot; for the specific GPU instance if you want to use GPU-P (partitioning) mode, or set as the string which contains &quot;DeviceInterface&quot; for using GPU-PV (paravirtualization) mode.]"
              TextWrapping="Wrap" />
            <StackPanel x:Name="GpuDevicePanel" Spacing="4" />
            <Button
              x:Name="AddGpuDeviceButton"
              x:Uid="/VirtualMachineSettingsPage/AddGpuDeviceButton"
              Click="AddGpuDeviceButtonClick"
              Content="[Add]" AutomationProperties.AutomationId="AddGpuDeviceButton" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem x:Uid="/VirtualMachineSettingsPage/TabNetwork" Header="Network" AutomationProperties.AutomationId="TabNetwork">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,4,16,16" Spacing="8">
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/NetworkAdapterTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="[NetworkAdapters]" />
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/NetworkAdapterDescription"
              FontSize="12"
              Opacity="0.75"
              Text="[The network adapters setting object array of virtual machine.]"
              TextWrapping="Wrap" />
            <TextBlock x:Uid="/VirtualMachineSettingsPage/HostNetworksTitle" Text="Host network manager" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ComboBox x:Name="HostNetworksComboBox" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="HostNetworksComboBox" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Uid="/VirtualMachineSettingsPage/RefreshNetworks" Content="Refresh" Click="RefreshNetworksButtonClick" AutomationProperties.AutomationId="RefreshNetworks" />
              <Button x:Uid="/VirtualMachineSettingsPage/InspectNetwork" Content="Properties" Click="InspectNetworkButtonClick" AutomationProperties.AutomationId="InspectNetwork" />
              <Button x:Uid="/VirtualMachineSettingsPage/DeleteNetwork" Content="Delete managed network" Click="DeleteNetworkButtonClick" AutomationProperties.AutomationId="DeleteNetwork" />
            </StackPanel>
            <TextBox x:Name="NetworkPropertiesTextBox" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" TextWrapping="Wrap" AutomationProperties.AutomationId="NetworkPropertiesTextBox" />
            <TextBox x:Name="NetworkNameTextBox" x:Uid="/VirtualMachineSettingsPage/NetworkName" Header="New NAT (ICS) network name" AutomationProperties.AutomationId="NetworkNameTextBox" />
            <CheckBox x:Name="NetworkFirewallCheckBox" x:Uid="/VirtualMachineSettingsPage/NetworkFirewall" Content="Enable Hyper-V firewall" AutomationProperties.AutomationId="NetworkFirewallCheckBox" />
            <Button x:Uid="/VirtualMachineSettingsPage/CreateNetwork" Content="Create NAT network" Click="CreateNetworkButtonClick" AutomationProperties.AutomationId="CreateNetwork" />
            <TextBlock x:Uid="/VirtualMachineSettingsPage/NetworkManagerNote" Text="Select an existing network when adding a virtual NIC." TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel x:Name="MirroredNetworkingPanel" Spacing="8" Margin="0,12,0,12">
              <TextBlock x:Uid="/VirtualMachineSettingsPage/MirroredTitle" Text="Mirrored networking" FontSize="16" FontWeight="SemiBold" />
              <CheckBox x:Name="MirroredNetworkingCheckBox" x:Uid="/VirtualMachineSettingsPage/MirroredEnabled" Content="Enable HCN mirrored networking" AutomationProperties.AutomationId="MirroredNetworkingCheckBox" />
              <TextBlock x:Uid="/VirtualMachineSettingsPage/MirroredNote" Text="Requires a compatible Windows host, WSL networking dependency and NanaBox Guest Network Service in the guest." TextWrapping="Wrap" Opacity="0.75" />
              <TextBox x:Name="MirroredFirewallCreatorTextBox" x:Uid="/VirtualMachineSettingsPage/MirroredFirewallCreator" Header="Hyper-V firewall creator GUID (optional)" AutomationProperties.AutomationId="MirroredFirewallCreatorTextBox" />
              <TextBox x:Name="MirroredTcpPortsTextBox" x:Uid="/VirtualMachineSettingsPage/MirroredTcpPorts" Header="Reserved TCP ports (one per line)" AcceptsReturn="True" MinHeight="64" AutomationProperties.AutomationId="MirroredTcpPortsTextBox" />
              <TextBox x:Name="MirroredUdpPortsTextBox" x:Uid="/VirtualMachineSettingsPage/MirroredUdpPorts" Header="Reserved UDP ports (one per line)" AcceptsReturn="True" MinHeight="64" AutomationProperties.AutomationId="MirroredUdpPortsTextBox" />
            </StackPanel>
            <StackPanel x:Name="NetworkAdapterPanel" Spacing="4" />
            <Button
              x:Name="AddNetworkAdapterButton"
              x:Uid="/VirtualMachineSettingsPage/AddNetworkAdapterButton"
              Click="AddNetworkAdapterButtonClick"
              Content="[Add]" AutomationProperties.AutomationId="AddNetworkAdapterButton" />
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/NetworkNote"
              FontSize="12"
              Opacity="0.75"
              Text="[Note: Default behavior is use the default switch.]"
              TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem x:Uid="/VirtualMachineSettingsPage/TabHostManagement" Header="Host management" AutomationProperties.AutomationId="TabHostManagement">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="16,4,16,16" Spacing="8">
            <TextBlock x:Uid="/VirtualMachineSettingsPage/ManagedSwitchTitle" Text="Hyper-V virtual switches" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Uid="/VirtualMachineSettingsPage/ManagedSwitchNote" Text="Create and remove NanaBox-managed switches. Connect a VM through the HCN network picker when the switch is exposed by HCN." TextWrapping="Wrap" Opacity="0.75" />
            <ComboBox x:Name="ManagedSwitchesComboBox" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchesComboBox" Header="Switches" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ManagedSwitchesComboBox"></ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="/VirtualMachineSettingsPage/SwitchListButton" Content="Refresh switches" Tag="SwitchList" Click="HostManagementButtonClick" AutomationProperties.AutomationId="SwitchListButton" /><Button x:Uid="/VirtualMachineSettingsPage/SwitchDeleteButton" Content="Delete selected switch" Tag="SwitchDelete" Click="HostManagementButtonClick" AutomationProperties.AutomationId="SwitchDeleteButton" /></StackPanel>
            <TextBox x:Name="ManagedSwitchNameTextBox" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchNameTextBox" Header="New switch name" AutomationProperties.AutomationId="ManagedSwitchNameTextBox" />
            <ComboBox x:Name="ManagedSwitchTypeComboBox" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchTypeComboBox" Header="Switch type" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ManagedSwitchTypeComboBox" SelectedIndex="0"><ComboBoxItem Tag="Internal" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchTypeComboBoxInternal" Content="Internal" AutomationProperties.AutomationId="ManagedSwitchTypeComboBoxInternal" /><ComboBoxItem Tag="Private" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchTypeComboBoxPrivate" Content="Private" AutomationProperties.AutomationId="ManagedSwitchTypeComboBoxPrivate" /><ComboBoxItem Tag="External" x:Uid="/VirtualMachineSettingsPage/ManagedSwitchTypeComboBoxExternal" Content="External" AutomationProperties.AutomationId="ManagedSwitchTypeComboBoxExternal" /></ComboBox>
            <ComboBox x:Name="PhysicalAdaptersComboBox" x:Uid="/VirtualMachineSettingsPage/PhysicalAdaptersComboBox" Header="Physical adapter (external switch)" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="PhysicalAdaptersComboBox"></ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="/VirtualMachineSettingsPage/AdapterListButton" Content="Refresh adapters" Tag="AdapterList" Click="HostManagementButtonClick" AutomationProperties.AutomationId="AdapterListButton" /><Button x:Uid="/VirtualMachineSettingsPage/SwitchCreateButton" Content="Create switch" Tag="SwitchCreate" Click="HostManagementButtonClick" AutomationProperties.AutomationId="SwitchCreateButton" /></StackPanel>
            <TextBlock x:Uid="/VirtualMachineSettingsPage/FirewallManagerTitle" Text="Hyper-V firewall" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Uid="/VirtualMachineSettingsPage/FirewallManagerNote" Text="Create a dedicated firewall creator for NanaBox. Changes apply to every endpoint using that creator. External creators are read-only." TextWrapping="Wrap" Opacity="0.75" />
            <ComboBox x:Name="FirewallCreatorsComboBox" x:Uid="/VirtualMachineSettingsPage/FirewallCreatorsComboBox" Header="Firewall creators" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FirewallCreatorsComboBox"></ComboBox>
