                AutomationProperties.Name="Disable Basic Session DPI Scaling"
                ToolTipService.ToolTip="(Optional) Disable the DPI scaling for the Basic Session Mode of virtual machine if set it true." AutomationProperties.AutomationId="DisableDpiScalingCheckBox" />
            </Grid>
            <CheckBox x:Name="DpiOverrideCheckBox" x:Uid="/VirtualMachineSettingsPage/DpiOverride" Content="Override display scaling" AutomationProperties.AutomationId="DpiOverrideCheckBox" />
            <TextBox x:Name="DpiScaleTextBox" x:Uid="/VirtualMachineSettingsPage/DpiScale" Header="Display scaling (100–500%)" AutomationProperties.AutomationId="DpiScaleTextBox" AutomationProperties.Name="Display scaling" InputScope="Number" />
            <CheckBox x:Name="ContentResizingCheckBox" x:Uid="/VirtualMachineSettingsPage/ContentResizing" Content="Resize the enhanced-session desktop with the window" AutomationProperties.AutomationId="ContentResizingCheckBox" />
            <CheckBox x:Name="ConnectionBarCheckBox" x:Uid="/VirtualMachineSettingsPage/ConnectionBar" Content="Show connection bar in full screen" AutomationProperties.AutomationId="ConnectionBarCheckBox" />
            <StackPanel x:Name="PoliciesSection" Spacing="4">
              <TextBlock x:Name="SettingsLabel254"
                x:Uid="/VirtualMachineSettingsPage/PoliciesTitle"
                Margin="0,8,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Policies" TextWrapping="Wrap" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel255"
                  x:Uid="/VirtualMachineSettingsPage/PoliciesLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Policies"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="PoliciesTextBox"
                  x:Uid="/VirtualMachineSettingsPage/PoliciesTextBox"
                  Grid.Column="2"
                  MinWidth="0"
                  MinHeight="72"
                  HorizontalAlignment="Stretch"
                  AcceptsReturn="True"
                  AutomationProperties.HelpText="The string array of policies of virtual machine."
                  AutomationProperties.Name="Policies"
                  TextWrapping="Wrap"
                  ToolTipService.ToolTip="The string array of policies of virtual machine." AutomationProperties.AutomationId="PoliciesTextBox" />
              </Grid>
              <TextBlock x:Name="SettingsLabel256"
                x:Uid="/VirtualMachineSettingsPage/PolicyFormatNote"
                FontSize="12"
                Opacity="0.75"
                Text="Enter one policy per line."
                TextWrapping="Wrap" />
              <TextBlock x:Name="SettingsLabel257"
                x:Uid="/VirtualMachineSettingsPage/PoliciesNote"
                FontSize="12"
                Opacity="0.75"
                Text="Note: These policies need Windows 11 Version 24H2 or later Host OS."
                TextWrapping="Wrap" />
              <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <TextBlock x:Name="SettingsLabel258" x:Uid="/VirtualMachineSettingsPage/PolicyExamplesTextBox"
                  AutomationProperties.Name="Policy identifier examples (read-only)"
                  IsTextSelectionEnabled="True"
                  Text="LegacyPcrMeasurement DisableSha384Pcr LegacyRteWidth LegacyTrustedLaunchMemoryMap LegacyApicSelectionLogic LegacyApicManganeseOverride LegacyGpaLayout ForceLegacyHcl ForceCurrentHcl UseExtendedMaxVpPerSocketLimit"
                  TextWrapping="NoWrap" AutomationProperties.AutomationId="PolicyExamplesTextBox" />
              </ScrollViewer>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Padding="16,8,16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="ConfigurationStatusTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="112" AutomationProperties.AutomationId="ConfigurationStatusTextBox" />
      <Button Grid.Column="1" x:Name="ValidateConfigurationButton" x:Uid="/VirtualMachineSettingsPage/ValidateConfiguration" Content="Check settings" VerticalAlignment="Top" Click="ValidateConfigurationButtonClick" AutomationProperties.AutomationId="ValidateConfigurationButton" />
      <Button
        x:Name="ApplyButton"
        x:Uid="/VirtualMachineSettingsPage/ApplyButton"
        Grid.Column="2"
        Margin="0,0,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="Save changes"
        Click="ApplyButtonClick" AutomationProperties.AutomationId="ApplyButton">
        <TextBlock x:Name="SettingsLabel259"
          x:Uid="/VirtualMachineSettingsPage/ApplyButtonTextBlock"
          Text="Save changes"
          TextWrapping="Wrap" />
      </Button>
    </Grid>
  </Grid>
</Page>
