<Page
  x:Class="NanaBox.VirtualMachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaBox"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Padding="16,8">
      <Grid.Background>
        <SolidColorBrush Opacity="0.2" Color="{ThemeResource SystemChromeHighColor}" />
      </Grid.Background>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="ReloadButton"
        x:Uid="/VirtualMachineSettingsPage/ReloadButton"
        Grid.Column="0"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="Reload configuration"
        Click="ReloadButtonClick" AutomationProperties.AutomationId="ReloadButton">
        <TextBlock x:Name="SettingsLabel1"
          x:Uid="/VirtualMachineSettingsPage/ReloadButtonTextBlock"
          Text="Reload"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="OpenButton"
        x:Uid="/VirtualMachineSettingsPage/OpenButton"
        Grid.Column="1"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="Edit configuration file in Notepad"
        Click="OpenButtonClick" AutomationProperties.AutomationId="OpenButton">
        <TextBlock x:Name="SettingsLabel2"
          x:Uid="/VirtualMachineSettingsPage/OpenButtonTextBlock"
          Text="Edit file"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ReferenceButton"
        x:Uid="/VirtualMachineSettingsPage/ReferenceButton"
        Grid.Column="2"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="Configuration help"
        Click="ReferenceButtonClick" AutomationProperties.AutomationId="ReferenceButton">
        <TextBlock x:Name="SettingsLabel3"
          x:Uid="/VirtualMachineSettingsPage/ReferenceButtonTextBlock"
          Text="Help"
          TextWrapping="Wrap" />
      </Button>

    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SettingsNavigationColumn" Width="208" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderThickness="0,0,1,0" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
        <Grid Padding="8,12,8,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="SettingsLabel4" x:Uid="/VirtualMachineSettingsPage/SettingsNavigationTitle" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,12" TextWrapping="Wrap" />
          <ListView Grid.Row="1" x:Name="SettingsNavigation" SelectionMode="Single" IsItemClickEnabled="False"
            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            AutomationProperties.AutomationId="SettingsNavigation">
            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListViewItem x:Name="NavGeneral" x:Uid="/VirtualMachineSettingsPage/TabGeneral" Content="General &amp; system" AutomationProperties.AutomationId="TabGeneral" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavGpu" x:Uid="/VirtualMachineSettingsPage/TabGpu" Content="Graphics" AutomationProperties.AutomationId="TabGpu" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavStorage" x:Uid="/VirtualMachineSettingsPage/TabStorage" Content="Storage" AutomationProperties.AutomationId="TabStorage" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavNetwork" x:Uid="/VirtualMachineSettingsPage/TabNetwork" Content="Network" AutomationProperties.AutomationId="TabNetwork" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavShares" x:Uid="/VirtualMachineSettingsPage/TabShares" Content="Shared folders" AutomationProperties.AutomationId="TabShares" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavSession" x:Uid="/VirtualMachineSettingsPage/TabSession" Content="Keyboard &amp; session" AutomationProperties.AutomationId="TabSession" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavSerial" x:Uid="/VirtualMachineSettingsPage/TabSerial" Content="Serial ports" AutomationProperties.AutomationId="TabSerial" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavGuestTools" x:Uid="/VirtualMachineSettingsPage/TabGuestTools" Content="Guest tools" AutomationProperties.AutomationId="TabGuestTools" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavHostManagement" x:Uid="/VirtualMachineSettingsPage/TabHostManagement" Content="Host networking" AutomationProperties.AutomationId="TabHostManagement" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavVmms" x:Uid="/VirtualMachineSettingsPage/TabVmms" Content="Hyper-V manager" AutomationProperties.AutomationId="TabVmms" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavHcn" x:Uid="/VirtualMachineSettingsPage/TabHcn" Content="Network resources" AutomationProperties.AutomationId="TabHcn" HorizontalContentAlignment="Stretch" />
          <ListViewItem x:Name="NavAdvanced" x:Uid="/VirtualMachineSettingsPage/TabAdvanced" Content="Advanced settings" AutomationProperties.AutomationId="TabAdvanced" HorizontalContentAlignment="Stretch" />
          </ListView>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="SectionGeneral" Visibility="Visible" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="24,12,24,20" Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">

            <TextBlock
              x:Name="RuntimeNotice"
              x:Uid="/VirtualMachineSettingsPage/RuntimeNoticeText"
              Text="Some settings require the virtual machine to be shut down before they can be changed."
              TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsLabel5"
              x:Uid="/VirtualMachineSettingsPage/GeneralTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="General" TextWrapping="Wrap" />
            <StackPanel x:Name="GuestTypeRow" Spacing="4">
              <TextBlock x:Name="SettingsLabel6" x:Uid="/VirtualMachineSettingsPage/GuestTypeLabel" Text="Guest operating system" TextWrapping="Wrap" />
              <ComboBox x:Name="GuestTypeComboBox" HorizontalAlignment="Stretch" SelectionChanged="GuestTypeSelectionChanged" AutomationProperties.AutomationId="GuestTypeComboBox">
                <ComboBoxItem x:Name="SettingsLabel7" x:Uid="/VirtualMachineSettingsPage/GuestUnknown" Content="Unknown" AutomationProperties.AutomationId="GuestUnknown" />
                <ComboBoxItem Content="Windows" AutomationProperties.AutomationId="GuestWindows" />
                <ComboBoxItem Content="Linux" AutomationProperties.AutomationId="GuestLinux" />
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="NameRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel8"
                  x:Uid="/VirtualMachineSettingsPage/NameLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Name"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="NameTextBox"
                  x:Uid="/VirtualMachineSettingsPage/NameTextBox"
                  Grid.Column="2"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.HelpText="The unique name of virtual machine."
                  AutomationProperties.Name="Name"
                  ToolTipService.ToolTip="The unique name of virtual machine." AutomationProperties.AutomationId="NameTextBox" />
              </Grid>
            </StackPanel>
            <StackPanel x:Name="ProcessorCountRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel9"
                  x:Uid="/VirtualMachineSettingsPage/ProcessorCountLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Virtual processors"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="ProcessorCountTextBox"
                  x:Uid="/VirtualMachineSettingsPage/ProcessorCountTextBox"
                  Grid.Column="2"
                  MinWidth="0"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="Choose how many virtual CPU cores are available to the guest."
                  AutomationProperties.Name="Virtual processors"
                  ToolTipService.ToolTip="Choose how many virtual CPU cores are available to the guest." AutomationProperties.AutomationId="ProcessorCountTextBox" />
              </Grid>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SettingsLabel10"
                x:Uid="/VirtualMachineSettingsPage/MemorySizeLabel"
                MinWidth="0"
                VerticalAlignment="Center"
                Text="Memory (MiB)"
                TextWrapping="Wrap" />
              <TextBox
                x:Name="MemorySizeTextBox"
                x:Uid="/VirtualMachineSettingsPage/MemorySizeTextBox"
                Grid.Column="2"
                MinWidth="0"
                HorizontalAlignment="Left"
                AutomationProperties.HelpText="Choose how much memory is available to the guest, in MiB."
                AutomationProperties.Name="Memory (MiB)"
                ToolTipService.ToolTip="Choose how much memory is available to the guest, in MiB." AutomationProperties.AutomationId="MemorySizeTextBox" />
            </Grid>
            <StackPanel x:Name="ResourceAllocationPanel" Spacing="8">
              <TextBlock x:Name="SettingsLabel11" x:Uid="/VirtualMachineSettingsPage/ResourceAllocationHeading" Text="Resource allocation" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBox x:Name="ProcessorLimitTextBox" x:Uid="/VirtualMachineSettingsPage/ProcessorLimitTextBox" Header="CPU limit (0 = default; 100000 = 100%)" AutomationProperties.Name="CPU limit (0 = default; 100000 = 100%)" AutomationProperties.AutomationId="ProcessorLimitTextBox" />
              <TextBox x:Name="ProcessorWeightTextBox" x:Uid="/VirtualMachineSettingsPage/ProcessorWeightTextBox" Header="CPU scheduling weight (0 = default; 1–10000)" AutomationProperties.Name="CPU scheduling weight (0 = default; 1–10000)" AutomationProperties.AutomationId="ProcessorWeightTextBox" />
              <CheckBox x:Name="MemoryOvercommitCheckBox" x:Uid="/VirtualMachineSettingsPage/MemoryOvercommitCheckBox" Content="Allow pagefile-backed virtual machine memory" AutomationProperties.Name="Allow pagefile-backed virtual machine memory" AutomationProperties.AutomationId="MemoryOvercommitCheckBox" />
              <CheckBox x:Name="DeferredCommitCheckBox" x:Uid="/VirtualMachineSettingsPage/DeferredCommitCheckBox" Content="Defer memory commit until first access" AutomationProperties.Name="Defer memory commit until first access" AutomationProperties.AutomationId="DeferredCommitCheckBox" />
              <TextBox x:Name="StorageIopsMaximumTextBox" x:Uid="/VirtualMachineSettingsPage/StorageIopsMaximumTextBox" Header="Storage IOPS limit (0 = default)" AutomationProperties.Name="Storage IOPS limit (0 = default)" AutomationProperties.AutomationId="StorageIopsMaximumTextBox" />
              <TextBox x:Name="StorageBandwidthMaximumTextBox" x:Uid="/VirtualMachineSettingsPage/StorageBandwidthMaximumTextBox" Header="Storage bandwidth limit (bytes/s; 0 = default)" AutomationProperties.Name="Storage bandwidth limit (bytes/s; 0 = default)" AutomationProperties.AutomationId="StorageBandwidthMaximumTextBox" />
            </StackPanel>
            <StackPanel x:Name="SecureBootRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel12"
                  x:Uid="/VirtualMachineSettingsPage/SecureBootLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Secure Boot"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="SecureBootCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/SecureBootCheckBox"
                  Grid.Column="2"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="Check the boot loader signature during startup."
                  AutomationProperties.Name="Secure Boot"
                  ToolTipService.ToolTip="Check the boot loader signature during startup." AutomationProperties.AutomationId="SecureBootCheckBox" />
              </Grid>
            </StackPanel>
            <StackPanel x:Name="TpmRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel13"
                  x:Uid="/VirtualMachineSettingsPage/TpmLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Virtual TPM (Trusted Platform Module)"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="TpmCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/TpmCheckBox"
                  Grid.Column="2"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="Enable a virtual security chip for features such as Windows 11 and BitLocker."
                  AutomationProperties.Name="Trusted Platform Module (TPM)"
                  ToolTipService.ToolTip="Enable a virtual security chip for features such as Windows 11 and BitLocker." AutomationProperties.AutomationId="TpmCheckBox" />
              </Grid>
              <TextBlock x:Name="SettingsLabel14"
                x:Uid="/VirtualMachineSettingsPage/TpmNote"
                FontSize="12"
                Opacity="0.75"
                Text="Note: You need Windows 11 Version 24H2 or later Host OS."
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="VirtualizationExtensionsRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel15"
                  x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Nested virtualization"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="VirtualizationExtensionsCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsCheckBox"
                  Grid.Column="2"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="Enable this when running Hyper-V, WSL 2 or another hypervisor inside the guest."
                  AutomationProperties.Name="Expose Virtualization Extensions"
                  ToolTipService.ToolTip="Enable this when running Hyper-V, WSL 2 or another hypervisor inside the guest." AutomationProperties.AutomationId="VirtualizationExtensionsCheckBox" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SectionGpu" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="24,12,24,20" Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock x:Name="SettingsLabel16"
              x:Uid="/VirtualMachineSettingsPage/GpuTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="GPU" TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SettingsLabel17"
                x:Uid="/VirtualMachineSettingsPage/AssignmentModeLabel"
                MinWidth="0"
                VerticalAlignment="Center"
                Text="Graphics acceleration"
                TextWrapping="Wrap" />
              <ComboBox
                x:Name="AssignmentModeComboBox"
                x:Uid="/VirtualMachineSettingsPage/AssignmentModeComboBox"
                Grid.Column="2"
                MinWidth="120"
                HorizontalAlignment="Left"
                AutomationProperties.HelpText="Choose whether graphics acceleration is disabled, automatic or uses selected cards."
                AutomationProperties.Name="Graphics acceleration"
                ToolTipService.ToolTip="Choose whether graphics acceleration is disabled, automatic or uses selected cards." AutomationProperties.AutomationId="AssignmentModeComboBox">
                <ComboBoxItem x:Name="SettingsLabel18" x:Uid="/VirtualMachineSettingsPage/ChoiceDisabledItem2" Content="Disabled" AutomationProperties.AutomationId="ChoiceDisabledItem2" />
                <ComboBoxItem x:Name="SettingsLabel19" x:Uid="/VirtualMachineSettingsPage/ChoiceDefaultItem2" Content="Default" AutomationProperties.AutomationId="ChoiceDefaultItem2" />
                <ComboBoxItem x:Name="SettingsLabel20" x:Uid="/VirtualMachineSettingsPage/ChoiceListItem" Content="Selected GPUs" AutomationProperties.AutomationId="ChoiceListItem" />
                <ComboBoxItem x:Name="SettingsLabel21" x:Uid="/VirtualMachineSettingsPage/ChoiceMirrorItem" Content="Mirror All GPUs" AutomationProperties.AutomationId="ChoiceMirrorItem" />
              </ComboBox>
            </Grid>
            <StackPanel x:Name="EnableHostDriverStoreRow" Spacing="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel22"
                  x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Use host graphics drivers"
                  TextWrapping="Wrap" />
                <CheckBox
                  x:Name="EnableHostDriverStoreCheckBox"
                  x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreCheckBox"
                  Grid.Column="2"
                  HorizontalAlignment="Left"
                  AutomationProperties.HelpText="Expose read-only host GPU driver directories for the selected guest operating system. Linux uses Plan 9; Windows uses the driver store and Virtual SMB where supported."
                  AutomationProperties.Name="Share Host Driver Store"
                  ToolTipService.ToolTip="Expose read-only host GPU driver directories for the selected guest operating system. Linux uses Plan 9; Windows uses the driver store and Virtual SMB where supported." AutomationProperties.AutomationId="EnableHostDriverStoreCheckBox" />
              </Grid>
              <TextBlock x:Name="SettingsLabel23"
                x:Uid="/VirtualMachineSettingsPage/ShareNote"
                FontSize="12"
                Opacity="0.75"
                Text="Note: You cannot suspend the virtual machine properly if this option is enabled."
                TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="GpuDeviceSection" Spacing="4" Visibility="Collapsed">
              <TextBlock x:Name="SettingsLabel24"
                x:Uid="/VirtualMachineSettingsPage/GpuDeviceTitle"
                Margin="0,8,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Selected GPUs" TextWrapping="Wrap" />
              <TextBlock x:Name="SettingsLabel25"
                x:Uid="/VirtualMachineSettingsPage/GpuDeviceDescription"
                FontSize="12"
                Opacity="0.75"
                Text="Choose which host graphics cards the virtual machine can use. The default partition selection works for most virtual machines."
                TextWrapping="Wrap" />
              <StackPanel x:Name="GpuDevicePanel" Spacing="4" />
              <Button
                x:Name="AddGpuDeviceButton"
                x:Uid="/VirtualMachineSettingsPage/AddGpuDeviceButton"
                Click="AddGpuDeviceButtonClick"
                Content="Add" AutomationProperties.AutomationId="AddGpuDeviceButton" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SectionStorage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="24,12,24,20" Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock x:Name="SettingsLabel26"
              x:Uid="/VirtualMachineSettingsPage/ScsiDeviceTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="Virtual disks and optical drives" TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsLabel27"
              x:Uid="/VirtualMachineSettingsPage/ScsiDeviceDescription"
              FontSize="12"
              Opacity="0.75"
              Text="Attach a virtual disk or an ISO installation image. Use the virtual disk manager to create or resize disks."
              TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsLabel28" x:Uid="/VirtualMachineSettingsPage/DiskManagerTitle" Text="Virtual disk manager" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBox x:Name="DiskPathTextBox" x:Uid="/VirtualMachineSettingsPage/DiskPath" Header="VHD/VHDX path" AutomationProperties.AutomationId="DiskPathTextBox" />
            <Button x:Name="SettingsLabel29" x:Uid="/VirtualMachineSettingsPage/DiskBrowse" Content="Browse existing disk" Tag="Browse" Click="DiskManagerButtonClick" AutomationProperties.AutomationId="DiskBrowse" />
            <TextBox x:Name="DiskSizeTextBox" x:Uid="/VirtualMachineSettingsPage/DiskSize" Header="Capacity (MiB)" Text="32768" AutomationProperties.AutomationId="DiskSizeTextBox" />
            <StackPanel Orientation="Vertical" Spacing="8" Margin="0,8,0,8">
              <Button x:Name="SettingsLabel30" x:Uid="/VirtualMachineSettingsPage/DiskCreate" Content="Create VHD" Tag="Create" Click="DiskManagerButtonClick" AutomationProperties.AutomationId="DiskCreate" />
              <Button x:Name="SettingsLabel31" x:Uid="/VirtualMachineSettingsPage/DiskResize" Content="Expand VHD" Tag="Resize" Click="DiskManagerButtonClick" AutomationProperties.AutomationId="DiskResize" />
              <Button x:Name="SettingsLabel32" x:Uid="/VirtualMachineSettingsPage/DiskCompact" Content="Compact VHD" Tag="Compact" Click="DiskManagerButtonClick" AutomationProperties.AutomationId="DiskCompact" />
              <Button x:Name="SettingsLabel33" x:Uid="/VirtualMachineSettingsPage/DiskInspect" Content="Inspect" Tag="Inspect" Click="DiskManagerButtonClick" AutomationProperties.AutomationId="DiskInspect" />
            </StackPanel>
            <TextBox x:Name="DiskResultTextBox" x:Uid="/VirtualMachineSettingsPage/DiskResult" Header="Operation result" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" AutomationProperties.AutomationId="DiskResultTextBox" />
            <StackPanel x:Name="ScsiDevicePanel" Spacing="4" />
            <Button
              x:Name="AddScsiDeviceButton"
              x:Uid="/VirtualMachineSettingsPage/AddScsiDeviceButton"
              Click="AddScsiDeviceButtonClick"
              Content="Add" AutomationProperties.AutomationId="AddScsiDeviceButton" />
            <TextBlock x:Name="SettingsLabel34"
              x:Uid="/VirtualMachineSettingsPage/ScsiNote"
              FontSize="12"
              Opacity="0.75"
              Text="An optical drive can be left empty. Select an ISO file to insert a disc."
              TextWrapping="Wrap" />
            <StackPanel x:Name="StateFilesSection" Spacing="4">
              <TextBlock x:Name="SettingsLabel35"
                x:Uid="/VirtualMachineSettingsPage/StateFilesTitle"
                Margin="0,8,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="State Files" TextWrapping="Wrap" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel36"
                  x:Uid="/VirtualMachineSettingsPage/GuestStateFileLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Guest state file"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="GuestStateFileTextBox"
                  x:Uid="/VirtualMachineSettingsPage/GuestStateFileTextBox"
                  Grid.Column="2"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.HelpText="(Optional) The path of guest state file for virtual machine."
                  AutomationProperties.Name="Guest state file"
                  ToolTipService.ToolTip="(Optional) The path of guest state file for virtual machine." AutomationProperties.AutomationId="GuestStateFileTextBox" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SettingsLabel37"
                  x:Uid="/VirtualMachineSettingsPage/RuntimeStateFileLabel"
                  MinWidth="0"
                  VerticalAlignment="Center"
                  Text="Saved runtime state file"
                  TextWrapping="Wrap" />
                <TextBox
                  x:Name="RuntimeStateFileTextBox"
                  x:Uid="/VirtualMachineSettingsPage/RuntimeStateFileTextBox"
                  Grid.Column="2"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.HelpText="(Optional) The path of runtime state file for virtual machine."
                  AutomationProperties.Name="Saved runtime state file"
                  ToolTipService.ToolTip="(Optional) The path of runtime state file for virtual machine." AutomationProperties.AutomationId="RuntimeStateFileTextBox" />
              </Grid>
              <TextBlock x:Name="SettingsLabel38"
                x:Uid="/VirtualMachineSettingsPage/StateNote2"
                FontSize="12"
                Opacity="0.75"
                Text="Note: The relative path is supported."
                TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SectionNetwork" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="24,12,24,20" Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock x:Name="SettingsLabel39"
              x:Uid="/VirtualMachineSettingsPage/NetworkAdapterTitle"
              Margin="0,8,0,0"
              FontSize="16"
              FontWeight="SemiBold"
              Text="Network Adapters" TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsLabel40"
              x:Uid="/VirtualMachineSettingsPage/NetworkAdapterDescription"
              FontSize="12"
              Opacity="0.75"
              Text="Add a network adapter and choose the network it connects to. The default switch provides internet access on most computers."
              TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsLabel41" x:Uid="/VirtualMachineSettingsPage/HostNetworksTitle" Text="Virtual networks on this computer" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
            <ComboBox x:Name="HostNetworksComboBox" x:Uid="/VirtualMachineSettingsPage/HostNetworksPicker" Header="Available networks" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="HostNetworksComboBox" />
            <StackPanel Orientation="Vertical" Spacing="8">
              <Button x:Name="RefreshNetworksControl" x:Uid="/VirtualMachineSettingsPage/RefreshNetworks" Content="Refresh" Click="RefreshNetworksButtonClick" AutomationProperties.AutomationId="RefreshNetworks" />
              <Button x:Name="InspectNetworkControl" x:Uid="/VirtualMachineSettingsPage/InspectNetwork" Content="Properties" Click="InspectNetworkButtonClick" AutomationProperties.AutomationId="InspectNetwork" />
              <Button x:Name="DeleteNetworkControl" x:Uid="/VirtualMachineSettingsPage/DeleteNetwork" Content="Delete managed network" Click="DeleteNetworkButtonClick" AutomationProperties.AutomationId="DeleteNetwork" />
            </StackPanel>
            <TextBox x:Name="NetworkPropertiesTextBox" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" TextWrapping="Wrap" AutomationProperties.AutomationId="NetworkPropertiesTextBox" />
            <TextBox x:Name="NetworkNameTextBox" x:Uid="/VirtualMachineSettingsPage/NetworkName" Header="New network name" AutomationProperties.AutomationId="NetworkNameTextBox" />
